---
import { ViewTransitions } from 'astro:transitions';
import { User, Mail } from 'lucide-astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Apuntes y recursos de FP Informática — Francisco Javier Hernández Illán' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<ViewTransitions />
	</head>
	<body>
		<div class="matrix-bg" aria-hidden="true">
			<div class="matrix-grid"></div>
			<div class="matrix-glow"></div>
			<div class="scanlines"></div>
		</div>

		<header class="site-header">
			<a href="/" class="site-logo">
				<span class="prompt" aria-hidden="true">&gt;_</span>
				<span class="logo-name">F. Javier Hernández</span>
			</a>

			<nav class="nav-links" aria-label="Navegación">
				<a href="/about" class="nav-link" aria-label="About" title="About">
					<User size={20} stroke-width={1.75} />
				</a>
				<a
					href="mailto:fj.hernandez@edu.gva.es"
					class="nav-link"
					aria-label="Email"
					title="Email"
				>
					<Mail size={20} stroke-width={1.75} />
				</a>
			</nav>

			<nav class="social-links" aria-label="Redes">
				<a
					href="https://github.com/fjavier-hernandez"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub"
					class="social-icon"
					title="GitHub"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
					</svg>
				</a>
				<a
					href="https://www.linkedin.com/in/fjavier-hernandez-illan/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
					class="social-icon"
					title="LinkedIn"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
				</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<style is:global>
			:root {
				--bg: #050805;
				--bg-elevated: #0a120a;
				--green: #00ff41;
				--green-dim: #00c833;
				--green-muted: rgba(0, 255, 65, 0.55);
				--green-faint: rgba(0, 255, 65, 0.12);
				--green-border: rgba(0, 255, 65, 0.28);
				--text: #d4f5d8;
				--text-muted: #6a9a72;
				--danger-muted: #3a4a3a;
				--font-mono: 'JetBrains Mono', ui-monospace, 'Cascadia Code', Menlo, monospace;
				--font-sans: 'IBM Plex Sans', system-ui, sans-serif;
				--header-h: 3.25rem;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				font-family: var(--font-sans);
				background: var(--bg);
				color: var(--text);
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				min-height: 100vh;
				min-height: 100dvh;
				display: flex;
				flex-direction: column;
				align-items: center;
				overflow-x: hidden;
				position: relative;
			}

			.matrix-bg {
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				background: var(--bg);
			}

			.matrix-grid {
				position: absolute;
				inset: 0;
				background-image:
					linear-gradient(rgba(0, 255, 65, 0.04) 1px, transparent 1px),
					linear-gradient(90deg, rgba(0, 255, 65, 0.04) 1px, transparent 1px);
				background-size: 48px 48px;
				mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, black 20%, transparent 75%);
			}

			.matrix-glow {
				position: absolute;
				inset: 0;
				background:
					radial-gradient(ellipse 70% 45% at 50% -10%, rgba(0, 255, 65, 0.14), transparent 55%),
					radial-gradient(ellipse 40% 30% at 85% 80%, rgba(0, 180, 50, 0.06), transparent 50%);
			}

			.scanlines {
				position: absolute;
				inset: 0;
				opacity: 0.035;
				background: repeating-linear-gradient(
					to bottom,
					transparent 0,
					transparent 2px,
					rgba(0, 0, 0, 0.8) 2px,
					rgba(0, 0, 0, 0.8) 4px
				);
			}

			.site-header {
				width: 100%;
				max-width: 1100px;
				height: var(--header-h);
				padding: 0 1.25rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				border-bottom: 1px solid var(--green-border);
				background: rgba(5, 8, 5, 0.75);
				backdrop-filter: blur(8px);
			}

			.site-logo {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--green);
				text-decoration: none;
				letter-spacing: -0.02em;
				white-space: nowrap;
			}

			.site-logo .prompt {
				color: var(--green-dim);
				opacity: 0.9;
			}

			.site-logo:hover .logo-name {
				text-shadow: 0 0 12px rgba(0, 255, 65, 0.45);
			}

			.nav-links {
				display: flex;
				gap: 0.5rem;
				align-items: center;
				margin-left: auto;
			}

			.nav-link,
			.social-icon {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 2.25rem;
				height: 2.25rem;
				color: var(--green-muted);
				border: 1px solid transparent;
				border-radius: 0.35rem;
				text-decoration: none;
				transition: color 0.2s, border-color 0.2s, background 0.2s, box-shadow 0.2s;
			}

			.nav-link:hover,
			.social-icon:hover {
				color: var(--green);
				border-color: var(--green-border);
				background: var(--green-faint);
				box-shadow: 0 0 12px rgba(0, 255, 65, 0.15);
			}

			.social-links {
				display: flex;
				gap: 0.35rem;
				align-items: center;
				margin-left: 0.35rem;
			}

			main {
				width: 100%;
				max-width: 1100px;
				flex: 1;
				padding: 0.85rem 1.25rem 1rem;
				display: flex;
				flex-direction: column;
			}

			a {
				color: inherit;
			}

			@media (max-width: 640px) {
				.logo-name {
					font-size: 0.82rem;
				}
				.site-header {
					padding: 0 0.85rem;
				}
				main {
					padding: 0.75rem 0.85rem 1rem;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					animation: none !important;
					transition: none !important;
				}
			}
		</style>
	</body>
</html>
