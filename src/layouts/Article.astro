---
import Layout from './Layout.astro';

interface Props {
	title: string;
	description?: string;
	eyebrow: string;
	heading: string;
	backHref: string;
	backLabel: string;
}

const { title, description, eyebrow, heading, backHref, backLabel } = Astro.props;
---

<Layout title={title} description={description}>
	<article class="article">
		<a href={backHref} class="back">{backLabel}</a>

		<header class="article-header">
			<p class="eyebrow">{eyebrow}</p>
			<h1>{heading}</h1>
		</header>

		<div class="content">
			<slot />
		</div>
	</article>
</Layout>

<style>
	.article {
		max-width: 46rem;
		margin: 0.5rem auto 1.5rem;
		padding: 1.35rem 1.5rem 1.6rem;
		background: rgba(10, 18, 10, 0.85);
		border: 1px solid var(--green-border);
		border-radius: 0.4rem;
		position: relative;
	}

	.article::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--green);
		box-shadow: 0 0 10px rgba(0, 255, 65, 0.45);
		border-radius: 0.4rem 0 0 0.4rem;
	}

	.back {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--green-dim);
		text-decoration: none;
		margin-bottom: 1rem;
	}

	.back:hover {
		color: var(--green);
		text-shadow: 0 0 10px rgba(0, 255, 65, 0.35);
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.04em;
		margin: 0 0 0.35rem;
	}

	h1 {
		font-family: var(--font-mono);
		font-size: clamp(1.35rem, 2.4vw, 1.75rem);
		margin: 0 0 1.15rem;
		color: var(--green);
		letter-spacing: -0.02em;
		line-height: 1.25;
	}

	.content {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--text);
	}

	.content :global(section + section) {
		margin-top: 0.35rem;
	}

	.content :global(h2) {
		font-family: var(--font-mono);
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--green);
		letter-spacing: -0.02em;
		margin: 1.6rem 0 0.75rem;
		padding-top: 0.85rem;
		border-top: 1px solid rgba(0, 255, 65, 0.15);
		line-height: 1.3;
	}

	.content :global(section:first-child h2) {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}

	.content :global(h3) {
		font-family: var(--font-mono);
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--green-dim);
		margin: 1.15rem 0 0.45rem;
	}

	.content :global(p) {
		margin: 0 0 1rem;
	}

	.content :global(p:last-child) {
		margin-bottom: 0;
	}

	.content :global(strong) {
		color: var(--green);
		font-weight: 600;
	}

	.content :global(a) {
		color: var(--green);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: rgba(0, 255, 65, 0.4);
	}

	.content :global(a:hover) {
		text-decoration-color: var(--green);
	}

	.content :global(.slot-marker) {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		letter-spacing: 0.03em;
		color: var(--green);
		background: var(--green-faint);
		border: 1px dashed rgba(0, 255, 65, 0.45);
		border-radius: 0.35rem;
		padding: 0.75rem 0.9rem;
		margin: 0.35rem 0 1rem;
	}

	@media (max-width: 640px) {
		.article {
			padding: 1.1rem 1rem 1.25rem;
		}
	}
</style>
