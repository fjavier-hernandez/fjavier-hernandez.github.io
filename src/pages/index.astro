---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import courses from '../data/courses.json';
---

<Layout title="Apuntes FP Informática | F. Javier Hernández">
	<section class="hero">
		<p class="eyebrow"><span class="blink" aria-hidden="true">█</span> session://dashboard</p>
		<h1>Apuntes FP Informática</h1>
		<p class="subtitle">Accesos a materiales de módulos de ciclos formativos.</p>
	</section>

	<section class="grid" aria-label="Cursos y recursos">
		{courses.map((course) => (
			<Card
				title={course.title}
				subtitle={course.subtitle}
				url={course.url}
				icon={course.icon}
				status={course.status as 'live' | 'soon'}
			/>
		))}
	</section>

	<footer class="home-footer">
		<p>
			<span class="prompt" aria-hidden="true">$</span>
			{new Date().getFullYear()} Francisco Javier Hernández Illán
		</p>
	</footer>
</Layout>

<style>
	.hero {
		text-align: center;
		margin: 0.35rem 0 1rem;
		padding: 0.15rem 0;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.06em;
		text-transform: lowercase;
		margin: 0 0 0.45rem;
	}

	.blink {
		display: inline-block;
		color: var(--green);
		animation: blink 1.1s step-end infinite;
		margin-right: 0.35rem;
		font-size: 0.65rem;
		vertical-align: middle;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	h1 {
		font-family: var(--font-mono);
		font-size: clamp(1.45rem, 2.4vw, 2rem);
		font-weight: 700;
		line-height: 1.15;
		margin: 0 0 0.4rem;
		color: var(--green);
		letter-spacing: -0.03em;
		text-shadow: 0 0 24px rgba(0, 255, 65, 0.25);
	}

	.subtitle {
		margin: 0 auto;
		max-width: 36rem;
		font-size: 0.95rem;
		line-height: 1.4;
		color: var(--text-muted);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
		flex: 1;
		align-content: start;
	}

	.home-footer {
		margin-top: auto;
		padding-top: 0.85rem;
		border-top: 1px solid rgba(0, 255, 65, 0.12);
		text-align: center;
	}

	.home-footer p {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-muted);
	}

	.home-footer .prompt {
		color: var(--green-dim);
		margin-right: 0.35rem;
	}

	@media (max-width: 720px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.hero {
			margin-bottom: 0.85rem;
		}
	}

	/* Viewport alto: compactar un poco más para caber sin scroll */
	@media (min-width: 721px) and (max-height: 900px) {
		.hero {
			margin: 0.15rem 0 0.7rem;
		}
		h1 {
			font-size: 1.5rem;
		}
		.subtitle {
			font-size: 0.88rem;
		}
		.grid {
			gap: 0.6rem;
		}
	}
</style>
