---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
---

<Layout
	title="Coordinación | F. Javier Hernández"
	description="Materiales de coordinación TIC y de Formación en Empresa del IES Macià Abela."
>
	<section class="hero">
		<a href="/" class="back">&lt; volver al dashboard</a>
		<p class="eyebrow"><span class="blink" aria-hidden="true">█</span> session://coordinacion</p>
		<h1>Coordinación</h1>
		<p class="subtitle">
			Materiales de coordinación de Tecnologías de la Información y la Comunicación (TIC) y de
			Formación en Empresa en el IES Macià Abela.
		</p>
	</section>

	<section class="grid" aria-label="Materiales de coordinación">
		<Card
			title="Herramientas corporativas 26-27"
			subtitle="Seminario de centro · herramientas de la Conselleria y competencia digital docente"
			url="/coordinacion/herramientas-corporativas-26-27/"
			icon="Presentation"
			status="live"
		/>
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		margin: 0.35rem 0 1rem;
		padding: 0.15rem 0;
	}

	.back {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--green-dim);
		text-decoration: none;
		margin-bottom: 0.85rem;
	}

	.back:hover {
		color: var(--green);
		text-shadow: 0 0 10px rgba(0, 255, 65, 0.35);
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.06em;
		text-transform: lowercase;
		margin: 0 0 0.45rem;
	}

	.blink {
		display: inline-block;
		color: var(--green);
		animation: blink 1.1s step-end infinite;
		margin-right: 0.35rem;
		font-size: 0.65rem;
		vertical-align: middle;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	h1 {
		font-family: var(--font-mono);
		font-size: clamp(1.45rem, 2.4vw, 2rem);
		font-weight: 700;
		line-height: 1.15;
		margin: 0 0 0.4rem;
		color: var(--green);
		letter-spacing: -0.03em;
		text-shadow: 0 0 24px rgba(0, 255, 65, 0.25);
	}

	.subtitle {
		margin: 0 auto;
		max-width: 38rem;
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--text-muted);
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 34rem);
		justify-content: center;
		gap: 0.75rem;
		align-content: start;
	}
</style>
